{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Calendar": {
    "CalDavUrl": "https://mail.maddalena.me/SOGo/dav/",
    "Username": "matteo@matteofabbri.org",
    "CalendarPath": "Calendar/personal/",
    "UseFake": false
  },

  "Booking": {
    "TimeZone": "Europe/Rome",
    "WorkDays": [ 1, 2, 3, 4, 5 ],
    "WorkStart": "09:00",
    "WorkEnd": "18:00",
    "SlotMinutes": 30,
    "BufferMinutes": 15,
    "LeadHours": 24,
    "HorizonDays": 60,
    "DefaultDays": 14,
    "MaxDaysPerRequest": 31,
    "MaxNoteLength": 1000
  },

  "Blog": {
    "ContentPath": "App_Data/blog",
    "TimeZone": "Europe/Rome",
    "AuthorName": "Matteo Fabbri",
    "Auth": {
      "UseFake": false,
      "BaseUrl": "https://mail.maddalena.me",
      "ClientId": "",
      "ClientSecret": ""
    }
  },

  "RequestLog": {
    "Enabled": true,
    "Path": "App_Data/sperone",
    "GeoIpDatabasePath": "App_Data/geoip/dbip-city-lite.mmdb",
    "DatabaseName": "matteofabbri",
    "Collection": "requests",
    "RetentionDays": 90,
    "QueueCapacity": 8192,
    "BatchSize": 200,
    "FlushSeconds": 1,
    "HashCacheLines": 65536,
    "LogMemoryBits": 23,
    "LogPageBits": 22,
    "ExcludePaths": [ "/health", "/alive" ]
  }
}
