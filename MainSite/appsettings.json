{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "BotDetection": {
    "Enabled": true,
    "GrpcUrl": "http://localhost:50051",
    "TimeoutMilliseconds": 1000
  },

  "Calendar": {
    "CalDavUrl": "",
    "Username": "matteo@matteofabbri.org",
    "CalendarPath": "Calendar/personal/",
    "UseFake": false
  },

  "Booking": {
    "TimeZone": "Europe/Rome",
    "WorkDays": [ 1, 2, 3, 4, 5 ],
    "WorkStart": "09:00",
    "WorkEnd": "18:00",
    "BufferMinutes": 15,
    "LeadHours": 24,
    "HorizonDays": 60,
    "MinDurationMinutes": 15,
    "MaxDaysPerRequest": 31,
    "MaxNoteLength": 1000
  },

  "Blog": {
    "ContentPath": "App_Data/blog",
    "TimeZone": "Europe/Rome",
    "AuthorName": "Matteo Fabbri"
  },

  "Auth": {
    "DatabasePath": "App_Data/auth/auth.db",
    "BootstrapUsername": "",
    "BootstrapPassword": "",
    "BootstrapDisplayName": "",
    "MinPasswordLength": 12
  },

  "Umami": {
    "ScriptUrl": "",
    "WebsiteId": ""
  },

  "YtDlp": {
    "ExecutablePath": "",
    "AutoInstall": true,
    "TimeoutSeconds": 600,
    "MaxLinksPerRun": 20,
    "FormatSelector": "",
    "FfmpegPath": "",
    "MaxFileBytes": 209715200,
    "ExtraArguments": ""
  },

  "RequestLog": {    "Enabled": true,
    "Path": "App_Data/sperone",
    "GeoIpDatabasePath": "App_Data/geoip/dbip-city-lite.mmdb",
    "DatabaseName": "matteofabbri",
    "Collection": "requests",
    "RetentionDays": 90,
    "QueueCapacity": 8192,
    "BatchSize": 200,
    "FlushSeconds": 1,
    "HashCacheLines": 65536,
    "LogMemoryBits": 23,
    "LogPageBits": 22,
    "ExcludePaths": [ "/health", "/alive" ],
    "BackfillBotFlags": false,
    "BackfillDays": 90,
    "BackfillForce": false
  }
}
