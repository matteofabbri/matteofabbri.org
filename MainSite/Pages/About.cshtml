@page "/about"
@model MainSite.Pages.AboutModel
@{
    ViewData["Title"] = "About";
}

<header class="page-head">
    <div>
        <h1>@Model.PageContent.Title</h1>
        @if (!string.IsNullOrWhiteSpace(Model.PageContent.Description))
        {
            <p class="lede">@Model.PageContent.Description</p>
        }
    </div>
</header>

<div class="prose">
    @Html.Raw(BlogMarkdown.ToHtml(Model.PageContent.Markdown))
</div>
