@page "/"
@model MainSite.Pages.Blog.IndexModel
@{
    ViewData["Title"] = "Blog";
    var now = DateTimeOffset.UtcNow;
    string? jumboStyle = Model.PhotoUrl is null ? null : $"background-image: url('{Model.PhotoUrl}')";
}

<section class="jumbotron @(Model.PhotoUrl is null && Model.VideoUrl is null ? "no-photo" : null)" style="@jumboStyle">
    @if (!string.IsNullOrEmpty(Model.VideoUrl))
    {
        <video class="jumbotron-video" src="@Model.VideoUrl" autoplay muted loop playsinline aria-hidden="true"></video>
    }

    <nav class="social-bar" aria-label="Social links">
        <a class="social-link" href="https://github.com/matteofabbri" target="_blank" rel="noopener" aria-label="GitHub" title="GitHub">
            <img src="~/lib/social/github.svg" alt="" width="20" height="20" asp-append-version="true" />
        </a>
        <a class="social-link" href="https://www.instagram.com/il_qulto/" target="_blank" rel="noopener" aria-label="Instagram" title="Instagram">
            <img src="~/lib/social/instagram.svg" alt="" width="20" height="20" asp-append-version="true" />
        </a>
        <a class="social-link" href="https://www.tiktok.com/@@the_qult" target="_blank" rel="noopener" aria-label="TikTok" title="TikTok">
            <img src="~/lib/social/tiktok.svg" alt="" width="20" height="20" asp-append-version="true" />
        </a>
    </nav>

    <div class="jumbotron-inner">
        <h1>Matteo Fabbri</h1>
        @if (!string.IsNullOrWhiteSpace(Model.Lede))
        {
            <p class="lede">@Model.Lede</p>
        }
    </div>
</section>

<a class="manifesto-box" asp-page="/About">
    <span class="manifesto-title">@Model.ManifestoTitle</span>
    <span class="manifesto-text">@Model.ManifestoText</span>
    <span class="manifesto-cta">Read the manifesto →</span>
</a>

@if (Model.Posts.Count == 0)
{
    <div class="empty">
        <p>There is nothing to read yet.</p>
    </div>
}
else
{
    @if (Model.Tags.Count > 0)
    {
        <nav class="tag-cloud" aria-label="Tags">
            @foreach (string tag in Model.Tags)
            {
                <a class="tag" asp-page="/Blog/Tag" asp-route-tag="@BlogMarkdown.Slugify(tag)">@tag</a>
            }
        </nav>
    }

    <div class="post-list">
        @{
            // I primi cinque articoli si leggono per intero nella home: lo spazio
            // c'è, e chi arriva qui non deve cliccare per leggere. Dal sesto in
            // poi torna il riepilogo.
            int position = 0;
        }
        @foreach (var post in Model.Posts)
        {
            bool visible = post.IsVisibleAt(now);
            bool full = position++ < 5;
            <article class="post-card">
                <div class="post-meta">
                    <time datetime="@post.Published.UtcDateTime.ToString("yyyy-MM-dd")">@Model.Clock.Format(post.Published)</time>
                    @if (BlogMarkdown.ReadingMinutes(post.Markdown) > 0)
                    {
                        <span aria-hidden="true">·</span>
                        <span>@BlogMarkdown.ReadingMinutes(post.Markdown) min read</span>
                    }
                    @if (!visible)
                    {
                        <span class="badge @(post.Draft ? "badge-draft" : "badge-scheduled")">
                            @(post.Draft ? "draft" : "scheduled")
                        </span>
                    }
                </div>

                <h2 class="post-title">
                    <a asp-page="/Blog/Post" asp-route-slug="@post.Slug">@post.Title</a>
                </h2>

                @if (full)
                {
                    <div class="prose">
                        @Html.Raw(BlogMarkdown.ToHtml(post.Markdown))
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(post.Summary))
                {
                    <p class="post-summary">@post.Summary</p>
                }

                @if (post.Tags.Count > 0)
                {
                    <div class="tags">
                        @foreach (string tag in post.Tags)
                        {
                            <a class="tag" asp-page="/Blog/Tag" asp-route-tag="@BlogMarkdown.Slugify(tag)">@tag</a>
                        }
                    </div>
                }
            </article>
        }
    </div>
}