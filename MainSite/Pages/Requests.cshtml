@page "/requests"
@model MainSite.Pages.RequestsModel
@{
    ViewData["Title"] = "Richieste nel mondo";
    ViewData["WideLayout"] = true;
}

@section Head {
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/request-map.css" asp-append-version="true" />
}

<div class="page-head">
    <div>
        <p class="eyebrow">Il sito in numeri</p>
        <h1>Richieste nel mondo</h1>
        <p class="lede">
            Da quali paesi arrivano le richieste, @Model.PeriodLabel.
            User-agent e IP sono mostrati così come registrati; nessun utente autenticato.
        </p>
    </div>
    <form method="get" class="map-controls">
        <label class="field map-period">
            <span class="field-label">Periodo</span>
            <select name="days" onchange="this.form.submit()">
                <option value="7" selected="@(Model.Days == 7)">Ultimi 7 giorni</option>
                <option value="30" selected="@(Model.Days == 30)">Ultimi 30 giorni</option>
                <option value="90" selected="@(Model.Days == 90)">Ultimi 90 giorni</option>
            </select>
        </label>
        <noscript><button type="submit" class="button">Aggiorna</button></noscript>
    </form>
</div>

@if (Model.LoadFailed)
{
    <div class="alert error">
        <strong>Impossibile leggere i conteggi da Sperone.</strong>
        Controlla i log del sito: il database potrebbe non essere accessibile.
    </div>
}
else if (!Model.LogEnabled)
{
    <div class="alert error">
        <strong>Log delle richieste disattivato.</strong>
        Attiva <code>RequestLog:Enabled</code> per raccogliere i dati che alimentano questa pagina.
    </div>
}
else if (!Model.GeoIpAvailable)
{
    <div class="alert warning">
        <strong>Database GeoIP non configurato.</strong>
        La mappa resterà vuota finché non scarichi DB-IP Lite City in
        <code>@Model.GeoIpPath</code>. In locale esegui <code>.\deploy\update-geoip.ps1</code>;
        in produzione <code>sudo /opt/matteofabbri/update-geoip.sh /opt/matteofabbri/geoip</code>
        e riavvia il sito.
    </div>
}
else if (Model.GeoIpUpdated is { } updated)
{
    <p class="hint">GeoIP: DB-IP Lite City, aggiornato al @updated.ToLocalTime().ToString("d MMMM yyyy").</p>
}

<div class="map-summary">
    <div class="map-stat">
        <span class="map-number">@Model.FormatNumber(Model.TotalRequests)</span>
        <span class="map-label">richieste nel periodo</span>
    </div>
    <div class="map-stat">
        <span class="map-number">@Model.FormatNumber(Model.GeocodedRequests)</span>
        <span class="map-label">con un paese riconosciuto</span>
    </div>
    <div class="map-stat">
        <span class="map-number">@Model.FormatNumber(Model.UnknownRequests)</span>
        <span class="map-label">private o non geolocalizzate</span>
    </div>
</div>

@if (Model.TotalRequests == 0)
{
    <div class="empty">
        <p>Nessuna richiesta registrata nel periodo.</p>
        <p>Le nuove richieste compaiono qui entro pochi secondi.</p>
    </div>
}

<div class="map-card">
    <div class="map-header">
        <h2>Mappa dei paesi</h2>
        <div id="map-legend" class="map-legend" hidden>
            <span class="legend-title">Richieste</span>
            <div id="legend-scale" class="legend-scale"></div>
        </div>
    </div>
    <div id="request-map" class="request-map" role="application"
         aria-label="Mappa del mondo con i paesi colorati per numero di richieste"></div>
    <p id="map-loading" class="hint">Caricamento della mappa…</p>
    <p id="map-error" class="alert error" hidden>
        Impossibile caricare i confini dei paesi. Ricarica la pagina o controlla la console.
    </p>
</div>

@if (Model.Countries.Count > 0)
{
    <div class="table-wrap">
        <table class="admin-table country-table">
            <thead>
                <tr>
                    <th>Paese</th>
                    <th class="cell-number">Richieste</th>
                    <th class="cell-number">% sul totale</th>
                    <th class="country-bar-cell"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var country in Model.Countries)
                {
                    <tr>
                        <td>@country.Name</td>
                        <td class="cell-number">@Model.FormatNumber(country.Count)</td>
                        <td class="cell-number">@Model.PercentLabel(country.Count) %</td>
                        <td class="country-bar-cell">
                            <span class="country-bar" style="width:@(Model.BarWidth(country.Count))%"></span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h2 class="section-title">Richieste</h2>

@if (Model.Recent.Count == 0)
{
    <p class="hint">Nessuna richiesta pubblica registrata nel periodo.</p>
}
else
{
    <div class="table-wrap">
        <table class="admin-table requests-table">
            <thead>
                <tr>
                    <th>Quando</th>
                    <th>Richiesta</th>
                    <th>Esito</th>
                    <th>Paese</th>
                    <th>IP</th>
                    <th>Client ID</th>
                    <th>User-Agent</th>
                    <th class="cell-number">Durata</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Recent)
                {
                    <tr>
                        <td class="cell-date">@Model.FormatWhen(row.When)</td>
                        <td><code class="request-path">@row.Method @row.Path</code></td>
                        <td><span class="status status-@(row.StatusCode / 100)xx">@row.StatusCode</span></td>
                        <td>@row.Country</td>
                        <td><code class="remote-ip">@row.RemoteIp</code></td>
                        <td><code class="client-id">@row.ClientId</code></td>
                        <td><code class="user-agent">@row.UserAgent</code></td>
                        <td class="cell-number">@Model.FormatDuration(row.DurationMs)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <nav class="pagination" aria-label="Paginazione delle richieste">
        @if (Model.PageNumber > 1)
        {
            <a class="button button-secondary" asp-page="/Requests" asp-route-days="@Model.Days" asp-route-pageNumber="@(Model.PageNumber - 1)" rel="prev">← Precedenti</a>
        }
        else
        {
            <span class="button button-secondary pagination-disabled">← Precedenti</span>
        }

        <span class="pagination-info">
            @(Model.PublicTotal == 0
                ? "Nessuna richiesta pubblica"
                : $"Richieste {Model.FormatNumber(Model.FirstOnPage)}–{Model.FormatNumber(Model.LastOnPage)} di {Model.FormatNumber(Model.PublicTotal)} · pagina {Model.PageNumber} di {Model.PageCount}")
        </span>

        @if (Model.PageNumber < Model.PageCount)
        {
            <a class="button button-secondary" asp-page="/Requests" asp-route-days="@Model.Days" asp-route-pageNumber="@(Model.PageNumber + 1)" rel="next">Successive →</a>
        }
        else
        {
            <span class="button button-secondary pagination-disabled">Successive →</span>
        }
    </nav>
}

<p class="hint map-attribution">
    Geolocalizzazione IP: <a href="https://db-ip.com" target="_blank" rel="noopener">DB-IP</a> (CC BY 4.0).
    Confini: <a href="https://www.naturalearthdata.com" target="_blank" rel="noopener">Natural Earth</a> (pubblico dominio).
    Mappa: &copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors,
    <a href="https://leafletjs.com" target="_blank" rel="noopener">Leaflet</a>.
</p>

<script id="country-counts" type="application/json">@Html.Raw(Model.CountsJson)</script>

@section Scripts {
    <script src="~/lib/leaflet/leaflet.js" asp-append-version="true"></script>
    <script>
        (() => {
            const counts = JSON.parse(document.getElementById('country-counts').textContent);
            const total = @Model.TotalRequests.ToString(System.Globalization.CultureInfo.InvariantCulture);
            const map = L.map('request-map', { preferCanvas: true, scrollWheelZoom: true, minZoom: 1 })
                .setView([20, 10], 2);

            L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 8,
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
            }).addTo(map);

            const palette = ['#e9e7e1', '#d7efe9', '#a9dcd2', '#7cc9c0', '#4aa99f', '#206f68'];
            const values = Object.values(counts).filter(value => value > 0);
            const max = values.length ? Math.max(...values) : 0;
            const bucket = value => value <= 0
                ? 0
                : Math.min(5, 1 + Math.floor((value - 1) / Math.max(1, max) * 5));
            const color = value => palette[bucket(value)];
            const formatNumber = value => value.toLocaleString('it-IT');

            const isoOf = feature => {
                const properties = feature.properties;
                const code = (properties.ISO_A2 && properties.ISO_A2 !== '-99')
                    ? properties.ISO_A2
                    : properties.ISO_A2_EH;
                return code && code !== '-99' ? code.toUpperCase() : null;
            };

            const geo = L.geoJSON(null, {
                style: feature => {
                    const code = isoOf(feature);
                    return {
                        fillColor: color(code ? counts[code] || 0 : 0),
                        weight: 0.6,
                        color: '#ffffff',
                        fillOpacity: 0.9
                    };
                },
                onEachFeature: (feature, layer) => {
                    const code = isoOf(feature);
                    if (!code) return;

                    const count = counts[code] || 0;
                    const name = feature.properties.NAME_IT || feature.properties.NAME;
                    const percent = total ? (count * 100 / total).toFixed(1).replace('.', ',') : '0,0';
                    layer.bindTooltip(`${name}: ${formatNumber(count)}`, { sticky: true });
                    layer.bindPopup(`<strong>${name}</strong><br>${formatNumber(count)} richieste (${percent}% del totale)`);
                    layer.on('mouseover', () => layer.setStyle({ weight: 1.5, color: '#1c1b19' }));
                    layer.on('mouseout', () => geo.resetStyle(layer));
                }
            }).addTo(map);

            fetch('@Url.Content("~/maps/countries.geojson")')
                .then(response => {
                    if (!response.ok) throw new Error(`HTTP ${response.status}`);
                    return response.json();
                })
                .then(data => {
                    geo.addData(data);
                    document.getElementById('map-loading').hidden = true;
                    buildLegend(max);
                })
                .catch(error => {
                    console.error('Confini paesi:', error);
                    document.getElementById('map-loading').hidden = true;
                    document.getElementById('map-error').hidden = false;
                });

            function buildLegend(maxValue) {
                if (!maxValue) return;
                const scale = document.getElementById('legend-scale');
                const zero = document.createElement('span');
                zero.className = 'legend-item';
                zero.innerHTML = `<span class="legend-swatch" style="background:${palette[0]}"></span>0`;
                scale.appendChild(zero);
                for (let i = 1; i <= 5; i++) {
                    // Stessi intervalli della funzione bucket() usata per i colori.
                    const from = Math.ceil((i - 1) * maxValue / 5) + 1;
                    const to = Math.ceil(i * maxValue / 5);
                    if (from > maxValue) break;
                    const item = document.createElement('span');
                    item.className = 'legend-item';
                    item.innerHTML = `<span class="legend-swatch" style="background:${palette[i]}"></span>${formatNumber(from)}${to > from ? '–' + formatNumber(to) : ''}`;
                    scale.appendChild(item);
                }
                document.getElementById('map-legend').hidden = false;
            }
        })();
    </script>
}
