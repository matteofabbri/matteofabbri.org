@page "/requests"
@model MainSite.Pages.RequestsModel
@using MainSite.RequestLogging
@{
    ViewData["Title"] = "Requests around the world";
}

@section Head {
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/request-map.css" asp-append-version="true" />
}

<div class="page-head">
    <div>
        <p class="eyebrow">The site in numbers</p>
        <h1>Requests around the world</h1>
        <p class="lede">
            Where requests come from, @Model.PeriodLabel.
            User-agent and IP are shown as recorded; no authenticated users.
        </p>
    </div>
    <div class="map-toolbar">
        <form method="get" class="map-controls">
            @foreach (var filter in Model.ActiveFilters)
            {
                <input type="hidden" name="@filter.Key" value="@filter.Value" />
            }
            <label class="field map-period">
                <span class="field-label">Period</span>
                <select name="days" onchange="this.form.submit()">
                    <option value="1" selected="@(Model.Days == 1)">Last 24 hours</option>
                    <option value="7" selected="@(Model.Days == 7)">Last 7 days</option>
                    <option value="30" selected="@(Model.Days == 30)">Last 30 days</option>
                    <option value="90" selected="@(Model.Days == 90)">Last 90 days</option>
                </select>
            </label>
            <noscript><button type="submit" class="button">Refresh</button></noscript>
        </form>
        <a class="button button-secondary" asp-page-handler="Csv" asp-all-route-data="@Model.CsvRoute()"
           title="Download the current query as CSV" download>
            <svg class="button-icon" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" focusable="false">
                <path d="M8 1.5v8.4M4.6 6.6 8 10l3.4-3.4M2.5 13.5h11" fill="none" stroke="currentColor"
                      stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            Download CSV
        </a>
    </div>
</div>

@if (Model.HasFilters)
{
    <div class="filter-bar" role="group" aria-label="Active filters">
        @foreach (var filter in Model.ActiveFilters)
        {
            <a class="filter-chip" asp-page="/Requests" asp-all-route-data="@Model.RemoveFilterRoute(filter.Key)"
               title="Remove @filter.Label filter" aria-label="Remove @filter.Label filter">
                <span class="filter-chip-text">@filter.Label</span>
                <span class="filter-chip-x" aria-hidden="true">×</span>
            </a>
        }
    </div>
}

@if (Model.LoadFailed)
{
    <div class="alert error">
        <strong>Could not read the request counts from Sperone.</strong>
        Check the site logs: the database may be unreachable.
    </div>
}
else if (!Model.LogEnabled)
{
    <div class="alert error">
        <strong>Request logging is disabled.</strong>
        Enable <code>RequestLog:Enabled</code> to collect the data for this page.
    </div>
}
else if (!Model.GeoIpAvailable)
{
    <div class="alert warning">
        <strong>GeoIP database not configured.</strong>
        The map stays empty until you download DB-IP Lite City to
        <code>@Model.GeoIpPath</code>. Locally run <code>.\deploy\update-geoip.ps1</code>;
        in production <code>sudo /opt/matteofabbri/update-geoip.sh /opt/matteofabbri/geoip</code>
        and restart the site.
    </div>
}
else if (Model.GeoIpUpdated is { } updated)
{
    <p class="hint">GeoIP: DB-IP Lite City, updated on @updated.ToLocalTime().ToString("d MMMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("en-GB")).</p>
}

<div class="map-summary">
    <div class="map-stat">
        <span class="map-number">@Model.FormatNumber(Model.TotalRequests)</span>
        <span class="map-label">@(Model.HasFilters ? "matching requests" : "requests in the period")</span>
    </div>
    <div class="map-stat">
        <span class="map-number">@Model.FormatNumber(Model.GeocodedRequests)</span>
        <span class="map-label">with a recognized country</span>
    </div>
    <div class="map-stat">
        <span class="map-number">@Model.FormatNumber(Model.UnknownRequests)</span>
        <span class="map-label">private or not geolocated</span>
    </div>
</div>

@if (Model.TotalRequests > 0)
{
    <div class="map-card">
        <div class="map-header">
            <h2>@Model.ChartTitle</h2>
            <span class="hint">
                @Model.FormatNumber(Model.TotalBots) flagged as bots ·
                @Model.FormatNumber(Model.TotalMalicious) malicious ·
                @Model.FormatNumber(Model.UniqueVisitors) distinct visitors in the period
            </span>
        </div>
        <div class="chart-frame">
            <canvas id="visitor-chart" role="img" aria-label="@Model.ChartAriaLabel"></canvas>
        </div>
        <p class="hint">
            A visitor is a Client ID: same IP and same user-agent count once per @(Model.HourlyPeriod ? "hour" : "day").
            The summary, the chart and the list count the same requests: <code>/admin</code> pages are left out.
            The bot and malicious lines count the rows flagged by the model.
        </p>
    </div>
}

@if (Model.TotalRequests == 0)
{
    <div class="empty">
        <p>No requests recorded in the period@(Model.HasFilters ? " matching these filters" : "").</p>
        <p>New requests appear here within seconds.</p>
    </div>
}

<div class="map-card">
    <div class="map-header">
        <h2>Country map</h2>
        <div id="map-legend" class="map-legend" hidden>
            <span class="legend-title">Requests</span>
            <div id="legend-scale" class="legend-scale"></div>
        </div>
    </div>
    <div id="request-map" class="request-map" role="application"
         aria-label="World map with countries coloured by number of requests"></div>
    <p id="map-loading" class="hint">Loading the map…</p>
    <p id="map-error" class="alert error" hidden>
        Could not load the country borders. Reload the page or check the console.
    </p>
</div>

@if (Model.ContinentGroups.Count > 0)
{
    <div class="continent-groups">
        @for (var g = 0; g < Model.ContinentGroups.Count; g++)
        {
            var group = Model.ContinentGroups[g];
            <details class="continent-group" open="@(g == 0)">
                <summary>
                    <span class="continent-name">@group.Name</span>
                    <span class="continent-total">
                        @Model.FormatNumber(group.Total) · @Model.PercentLabel(group.Total) %
                    </span>
                </summary>
                <div class="table-wrap continent-table-wrap">
                    <table class="admin-table country-table">
                        <thead>
                            <tr>
                                <th>Country</th>
                                <th class="cell-number">Requests</th>
                                <th class="cell-number">% of total</th>
                                <th class="country-bar-cell"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var country in group.Countries)
                            {
                                <tr>
                                    <td>
                                        <a class="request-filter" asp-page="/Requests" asp-all-route-data="@Model.FilterRoute("country", country.Code)">@country.Name</a>
                                    </td>
                                    <td class="cell-number">@Model.FormatNumber(country.Count)</td>
                                    <td class="cell-number">@Model.PercentLabel(country.Count) %</td>
                                    <td class="country-bar-cell">
                                        <span class="country-bar" style="width:@(Model.BarWidth(country.Count))%"></span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </details>
        }
    </div>
}

<h2 class="section-title">Requests</h2>

@if (Model.Recent.Count == 0)
{
    <p class="hint">@(Model.HasFilters ? "No public requests match these filters." : "No public requests recorded in the period.")</p>
}
else
{
    <div class="table-wrap">
        <table class="admin-table requests-table">
            <thead>
                <tr>
                    <th>When</th>
                    <th>Request</th>
                    <th>Status</th>
                    <th>Bot</th>
                    <th>Malicious</th>
                    <th>Country</th>
                    <th>IP</th>
                    <th>Client ID</th>
                    <th>User-Agent</th>
                    <th class="cell-number">Duration</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Recent)
                {
                    <tr>
                        <td class="cell-date">@Model.FormatWhen(row.When)</td>
                        <td>
                            <code class="request-path">
                                @row.Method
                                @if (row.Href is string href)
                                {
                                    <a href="@href" target="_blank" rel="noopener noreferrer" title="Open @row.Path">@row.Path</a>
                                }
                                else
                                {
                                    @row.Path
                                }
                            </code>
                        </td>
                        <td><span class="status status-@(row.StatusCode / 100)xx">@row.StatusCode</span></td>
                        <td>
                            @if (row.IsBot is null)
                            {
                                <span class="bot-flag bot-unknown" title="The model did not flag this request">—</span>
                            }
                            else
                            {
                                <a class="bot-flag @RequestFlagState.BotBadgeClass(row.IsBot) bot-flag-link"
                                   asp-page="/Requests" asp-all-route-data="@Model.ToggleFilterRoute("bot", RequestFlagState.Value(row.IsBot))"
                                   title="@(row.IsBot == true ? "Bot requests — click to filter" : "Human requests — click to filter")">
                                    @(row.IsBot == true ? "bot" : "human")
                                </a>
                            }
                        </td>
                        <td>
                            @if (row.IsMaliciousURL is null)
                            {
                                <span class="bot-flag bot-unknown" title="The model did not flag this request">—</span>
                            }
                            else
                            {
                                <a class="bot-flag @RequestFlagState.MaliciousBadgeClass(row.IsMaliciousURL) bot-flag-link"
                                   asp-page="/Requests" asp-all-route-data="@Model.ToggleFilterRoute("malicious", RequestFlagState.Value(row.IsMaliciousURL))"
                                   title="@(row.IsMaliciousURL == true ? "Malicious requests — click to filter" : "Not malicious — click to filter")">
                                    @(row.IsMaliciousURL == true ? "yes" : "no")
                                </a>
                            }
                        </td>
                        <td>
                            <a class="request-filter" asp-page="/Requests" asp-all-route-data="@Model.FilterRoute("country", row.CountryCode)">@row.Country</a>
                        </td>
                        <td>
                            @if (row.RemoteIp != "—")
                            {
                                <code class="remote-ip"><a class="request-filter" asp-page="/Requests" asp-all-route-data="@Model.FilterRoute("ip", row.RemoteIp)">@row.RemoteIp</a></code>
                            }
                            else
                            {
                                <code class="remote-ip">@row.RemoteIp</code>
                            }
                        </td>
                        <td>
                            @if (row.ClientId != "—")
                            {
                                <code class="client-id"><a class="request-filter" asp-page="/Requests" asp-all-route-data="@Model.FilterRoute("clientId", row.ClientId)">@row.ClientId</a></code>
                            }
                            else
                            {
                                <code class="client-id">@row.ClientId</code>
                            }
                        </td>
                        <td>
                            @if (row.UserAgent != "—")
                            {
                                <code class="user-agent"><a class="request-filter" asp-page="/Requests" asp-all-route-data="@Model.FilterRoute("userAgent", row.UserAgent)">@row.UserAgent</a></code>
                            }
                            else
                            {
                                <code class="user-agent">@row.UserAgent</code>
                            }
                        </td>
                        <td class="cell-number">@Model.FormatDuration(row.DurationMs)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <nav class="pagination" aria-label="Request pagination">
        @if (Model.PageNumber > 1)
        {
            <a class="button button-secondary" asp-page="/Requests" asp-all-route-data="@Model.PageRoute(Model.PageNumber - 1)" rel="prev">← Previous</a>
        }
        else
        {
            <span class="button button-secondary pagination-disabled">← Previous</span>
        }

        <span class="pagination-info">
            @(Model.PublicTotal == 0
                ? "No public requests"
                : $"Requests {Model.FormatNumber(Model.FirstOnPage)}–{Model.FormatNumber(Model.LastOnPage)} of {Model.FormatNumber(Model.PublicTotal)} · page {Model.PageNumber} of {Model.PageCount}")
        </span>

        @if (Model.PageNumber < Model.PageCount)
        {
            <a class="button button-secondary" asp-page="/Requests" asp-all-route-data="@Model.PageRoute(Model.PageNumber + 1)" rel="next">Next →</a>
        }
        else
        {
            <span class="button button-secondary pagination-disabled">Next →</span>
        }
    </nav>
}

<p class="hint map-attribution">
    IP geolocation: <a href="https://db-ip.com" target="_blank" rel="noopener">DB-IP</a> (CC BY 4.0).
    Borders: <a href="https://www.naturalearthdata.com" target="_blank" rel="noopener">Natural Earth</a> (public domain).
    Map: &copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors,
    <a href="https://leafletjs.com" target="_blank" rel="noopener">Leaflet</a>.
</p>

<script id="country-counts" type="application/json">@Html.Raw(Model.CountsJson)</script>
<script id="visitor-series" type="application/json">@Html.Raw(Model.ChartJson())</script>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js" asp-append-version="true"></script>
    <script>
        (() => {
            const canvas = document.getElementById('visitor-chart');
            const source = document.getElementById('visitor-series');
            if (!canvas || !source || !window.Chart) return;

            const series = JSON.parse(source.textContent);
            const number = new Intl.NumberFormat('en-GB');
            let chart;

            const theme = () => {
                const styles = getComputedStyle(document.documentElement);
                const value = name => styles.getPropertyValue(name).trim();
                return {
                    accent: value('--accent'),
                    text: value('--text'),
                    muted: value('--muted'),
                    border: value('--border'),
                    surface: value('--surface'),
                    danger: value('--chart-danger') || '#b3261e',
                    font: getComputedStyle(document.body).fontFamily,
                };
            };

            // Chart.js disegna su canvas: i colori delle variabili CSS vanno
            // convertiti in rgba, con un gradiente verticale per le barre.
            const rgba = (color, alpha) => {
                const match = /^#([0-9a-f]{3}|[0-9a-f]{6})$/i.exec(color);
                if (!match) return color;
                const hex = match[1].length === 3
                    ? match[1].split('').map(c => c + c).join('')
                    : match[1];
                const n = parseInt(hex, 16);
                return `rgba(${(n >> 16) & 255}, ${(n >> 8) & 255}, ${n & 255}, ${alpha})`;
            };

            const build = () => {
                const colors = theme();
                if (chart) chart.destroy();

                chart = new Chart(canvas, {
                    type: 'bar',
                    data: {
                        labels: series.labels,
                        datasets: [
                            {
                                type: 'line',
                                label: 'Requests',
                                data: series.requests,
                                yAxisID: 'yRequests',
                                borderColor: colors.muted,
                                backgroundColor: rgba(colors.muted, 0.08),
                                borderWidth: 1.6,
                                borderDash: [5, 4],
                                pointRadius: 0,
                                pointHoverRadius: 4,
                                pointHoverBackgroundColor: colors.muted,
                                pointHoverBorderColor: colors.surface,
                                pointHoverBorderWidth: 2,
                                tension: 0.3,
                                fill: false,
                                order: 1,
                            },
                            {
                                type: 'line',
                                label: 'Bot requests',
                                data: series.bots,
                                yAxisID: 'yRequests',
                                borderColor: colors.accent,
                                backgroundColor: colors.accent,
                                borderWidth: 1.8,
                                pointRadius: 0,
                                pointHoverRadius: 4,
                                pointHoverBackgroundColor: colors.accent,
                                pointHoverBorderColor: colors.surface,
                                pointHoverBorderWidth: 2,
                                tension: 0.3,
                                fill: false,
                                order: 0,
                            },
                            {
                                type: 'line',
                                label: 'Malicious bots',
                                data: series.malicious,
                                yAxisID: 'yRequests',
                                borderColor: colors.danger,
                                backgroundColor: colors.danger,
                                borderWidth: 1.8,
                                pointRadius: 0,
                                pointHoverRadius: 4,
                                pointHoverBackgroundColor: colors.danger,
                                pointHoverBorderColor: colors.surface,
                                pointHoverBorderWidth: 2,
                                tension: 0.3,
                                fill: false,
                                order: 0,
                            },
                            {
                                type: 'bar',
                                label: 'Unique visitors',
                                data: series.visitors,
                                yAxisID: 'yVisitors',
                                backgroundColor: context => {
                                    const { ctx, chartArea } = context.chart;
                                    if (!chartArea) return rgba(colors.accent, 0.8);
                                    const gradient = ctx.createLinearGradient(0, chartArea.top, 0, chartArea.bottom);
                                    gradient.addColorStop(0, rgba(colors.accent, 0.95));
                                    gradient.addColorStop(1, rgba(colors.accent, 0.35));
                                    return gradient;
                                },
                                hoverBackgroundColor: colors.text,
                                borderRadius: 4,
                                borderSkipped: false,
                                maxBarThickness: series.hourly ? 26 : 14,
                                order: 2,
                            },
                        ],
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        animation: { duration: 550, easing: 'easeOutQuart' },
                        interaction: { mode: 'index', intersect: false },
                        plugins: {
                            legend: {
                                position: 'bottom',
                                align: 'start',
                                labels: {
                                    boxWidth: 12,
                                    boxHeight: 8,
                                    padding: 18,
                                    color: colors.muted,
                                    font: { family: colors.font, size: 12 },
                                },
                            },
                            tooltip: {
                                backgroundColor: colors.surface,
                                titleColor: colors.text,
                                bodyColor: colors.muted,
                                borderColor: colors.border,
                                borderWidth: 1,
                                padding: 10,
                                cornerRadius: 8,
                                usePointStyle: true,
                                boxWidth: 8,
                                boxHeight: 8,
                                callbacks: {
                                    title: items => series.titles[items[0].dataIndex] ?? items[0].label,
                                    label: item => ` ${item.dataset.label}: ${number.format(item.parsed.y)}`,
                                },
                            },
                        },
                        scales: {
                            x: {
                                grid: { display: false },
                                border: { display: false },
                                ticks: {
                                    color: colors.muted,
                                    maxRotation: 0,
                                    autoSkip: true,
                                    maxTicksLimit: series.hourly ? 8 : 10,
                                    font: { family: colors.font, size: 11 },
                                },
                            },
                            yVisitors: {
                                beginAtZero: true,
                                position: 'left',
                                border: { display: false },
                                grid: { color: colors.border, drawTicks: false },
                                ticks: {
                                    color: colors.accent,
                                    precision: 0,
                                    maxTicksLimit: 5,
                                    padding: 6,
                                    font: { family: colors.font, size: 11 },
                                },
                            },
                            yRequests: {
                                beginAtZero: true,
                                position: 'right',
                                border: { display: false },
                                grid: { display: false },
                                ticks: {
                                    color: colors.muted,
                                    precision: 0,
                                    maxTicksLimit: 5,
                                    padding: 6,
                                    font: { family: colors.font, size: 11 },
                                },
                            },
                        },
                    },
                });
            };

            build();
            window.matchMedia('(prefers-color-scheme: dark)')
                .addEventListener('change', build);
        })();
    </script>
    <script src="~/lib/leaflet/leaflet.js" asp-append-version="true"></script>
    <script>
        (() => {
            const counts = JSON.parse(document.getElementById('country-counts').textContent);
            const total = @Model.TotalRequests.ToString(System.Globalization.CultureInfo.InvariantCulture);
            const map = L.map('request-map', { preferCanvas: true, scrollWheelZoom: true, minZoom: 1 })
                .setView([20, 10], 2);

            L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 8,
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
            }).addTo(map);

            const palette = ['#e9e7e1', '#d7efe9', '#a9dcd2', '#7cc9c0', '#4aa99f', '#206f68'];
            const values = Object.values(counts).filter(value => value > 0);
            const max = values.length ? Math.max(...values) : 0;
            const bucket = value => value <= 0
                ? 0
                : Math.min(5, 1 + Math.floor((value - 1) / Math.max(1, max) * 5));
            const color = value => palette[bucket(value)];
            const formatNumber = value => value.toLocaleString('en-GB');

            const isoOf = feature => {
                const properties = feature.properties;
                const code = (properties.ISO_A2 && properties.ISO_A2 !== '-99')
                    ? properties.ISO_A2
                    : properties.ISO_A2_EH;
                return code && code !== '-99' ? code.toUpperCase() : null;
            };

            const geo = L.geoJSON(null, {
                style: feature => {
                    const code = isoOf(feature);
                    return {
                        fillColor: color(code ? counts[code] || 0 : 0),
                        weight: 0.6,
                        color: '#ffffff',
                        fillOpacity: 0.9
                    };
                },
                onEachFeature: (feature, layer) => {
                    const code = isoOf(feature);
                    if (!code) return;

                    const count = counts[code] || 0;
                    const name = feature.properties.NAME || feature.properties.NAME_IT;
                    const percent = total ? (count * 100 / total).toFixed(1) : '0.0';
                    layer.bindTooltip(`${name}: ${formatNumber(count)}`, { sticky: true });
                    layer.bindPopup(`<strong>${name}</strong><br>${formatNumber(count)} requests (${percent}% of total)`);
                    layer.on('mouseover', () => layer.setStyle({ weight: 1.5, color: '#1c1b19' }));
                    layer.on('mouseout', () => geo.resetStyle(layer));
                }
            }).addTo(map);

            fetch('@Url.Content("~/maps/countries.geojson")')
                .then(response => {
                    if (!response.ok) throw new Error(`HTTP ${response.status}`);
                    return response.json();
                })
                .then(data => {
                    geo.addData(data);
                    document.getElementById('map-loading').hidden = true;
                    buildLegend(max);
                })
                .catch(error => {
                    console.error('Country borders:', error);
                    document.getElementById('map-loading').hidden = true;
                    document.getElementById('map-error').hidden = false;
                });

            function buildLegend(maxValue) {
                if (!maxValue) return;
                const scale = document.getElementById('legend-scale');
                const zero = document.createElement('span');
                zero.className = 'legend-item';
                zero.innerHTML = `<span class="legend-swatch" style="background:${palette[0]}"></span>0`;
                scale.appendChild(zero);
                for (let i = 1; i <= 5; i++) {
                    // Stessi intervalli della funzione bucket() usata per i colori.
                    const from = Math.ceil((i - 1) * maxValue / 5) + 1;
                    const to = Math.ceil(i * maxValue / 5);
                    if (from > maxValue) break;
                    const item = document.createElement('span');
                    item.className = 'legend-item';
                    item.innerHTML = `<span class="legend-swatch" style="background:${palette[i]}"></span>${formatNumber(from)}${to > from ? '–' + formatNumber(to) : ''}`;
                    scale.appendChild(item);
                }
                document.getElementById('map-legend').hidden = false;
            }
        })();
    </script>
}
