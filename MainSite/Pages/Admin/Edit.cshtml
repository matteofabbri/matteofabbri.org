@page "/admin/edit/{slug?}"
@model MainSite.Pages.Admin.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "Nuovo articolo" : "Modifica articolo";
}

<div class="page-head">
    <div>
        <p class="eyebrow"><a asp-page="/Admin/Index">I tuoi articoli</a> / @(Model.IsNew ? "Nuovo" : "Modifica")</p>
        <h1>@(Model.IsNew ? "Nuovo articolo" : "Modifica articolo")</h1>
    </div>
    <div class="actions">
        @if (!Model.IsNew)
        {
            <a class="button button-secondary" asp-page="/Blog/Post" asp-route-slug="@Model.OriginalSlug" target="_blank" rel="noopener">Apri</a>
        }
    </div>
</div>

@if (TempData["Messaggio"] is string message)
{
    <div class="alert success">@message</div>
}
@if (TempData["Errore"] is string error)
{
    <div class="alert error">@error</div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert error">
        <ul>
            @foreach (var entry in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                if (!string.IsNullOrWhiteSpace(entry.ErrorMessage))
                {
                    <li>@entry.ErrorMessage</li>
                }
            }
        </ul>
    </div>
}

<form method="post" class="editor-form">
    <div class="field">
        <label asp-for="Input.Title">Titolo</label>
        <input asp-for="Input.Title" class="input input-title" autocomplete="off" />
    </div>

    <div class="field-row">
        <div class="field">
            <label asp-for="Input.Slug">Slug</label>
            <input asp-for="Input.Slug" class="input" autocomplete="off" placeholder="lo-ricaviamo-dal-titolo" />
            <span class="hint">L'indirizzo sarà <code>/blog/slug</code>. Se lo lasci vuoto lo ricaviamo dal titolo.</span>
        </div>
        <div class="field">
            <label asp-for="Input.Published">Pubblicazione</label>
            <input asp-for="Input.Published" class="input" type="datetime-local" />
            <span class="hint">Una data futura tiene l'articolo nascosto fino a quel momento.</span>
        </div>
    </div>

    <div class="field">
        <label asp-for="Input.Summary">Riepilogo</label>
        <textarea asp-for="Input.Summary" class="input" rows="2" maxlength="300"
                  placeholder="Due righe per l'elenco e per il feed. Se lo lasci vuoto lo ricaviamo dal testo."></textarea>
    </div>

    <div class="field">
        <label asp-for="Input.Tags">Tag</label>
        <input asp-for="Input.Tags" class="input" autocomplete="off" placeholder="progetti, matematica, note" />
        <span class="hint">Separati da virgola. Massimo 12.</span>
    </div>

    <div class="field">
        <label asp-for="Input.Markdown">Testo (Markdown)</label>
        <textarea asp-for="Input.Markdown" class="input editor" spellcheck="false"
                  placeholder="# Titolo del paragrafo&#10;&#10;Testo, **grassetto**, [link](https://esempio.it), elenchi..."></textarea>
        <span class="hint">
            Markdown: <code>## titolo</code>, <code>**grassetto**</code>, <code>[testo](url)</code>,
            <code>![descrizione](/blog/media/file.jpg)</code>. L'HTML grezzo non viene eseguito.
        </span>
    </div>

    <div class="editor-actions">
        <button type="submit" class="button">Salva</button>
        <label class="checkbox">
            <input asp-for="Input.Draft" />
            Bozza (non pubblicare)
        </label>
    </div>
</form>

@if (!Model.IsNew)
{
    <form method="post" asp-page-handler="Delete" asp-route-slug="@Model.OriginalSlug" class="danger-zone"
          onsubmit="return confirm('Spostare questo articolo nel cestino?');">
        <button type="submit" class="button button-danger">Elimina articolo</button>
        <span class="hint">Finisce nel cestino della cartella contenuti, non sparisce per sempre.</span>
    </form>
}
