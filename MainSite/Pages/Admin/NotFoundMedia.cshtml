@page "/admin/404"
@model MainSite.Pages.Admin.NotFoundMediaModel
@{
    ViewData["Title"] = "404 media";
}

<div class="page-head">
    <div>
        <p class="eyebrow"><a asp-page="/Admin/Index">Administration</a> / 404 media</p>
        <h1>404 media</h1>
        <p class="lede">Photos and videos shown at random on the 404 page.</p>
    </div>
</div>

@if (TempData["Messaggio"] is string message)
{
    <div class="alert success">@message</div>
}
@if (TempData["Errore"] is string error)
{
    <div class="alert error">@error</div>
}

<form method="post" enctype="multipart/form-data" class="upload-form"
      data-upload-form data-max-bytes="@MediaUploadBatch.MaxRequestBytes">
    <label class="field">
        <span class="field-label">Upload photos or videos</span>
        <input type="file" name="Upload" multiple
               accept="image/jpeg,image/png,image/gif,image/webp,image/avif,video/mp4,video/webm,video/quicktime,video/x-m4v" />
        <span class="hint">Drag files here or click to choose. Images up to 15 MB (JPG, PNG, GIF, WebP, AVIF); videos up to 25 MB (MP4, WebM, MOV, M4V).</span>
    </label>
    <button type="submit" class="button">Upload</button>
    <p class="drop-note" aria-hidden="true">Drop to upload</p>
    <p class="upload-status" data-upload-status role="status" hidden></p>
</form>

@if (Model.Files.Count == 0)
{
    <div class="empty">
        <p>No 404 media uploaded yet.</p>
        <p>The 404 page uses the images committed in <code>wwwroot/404</code>.</p>
    </div>
}
else
{
    <div class="media-grid">
        @foreach (var file in Model.Files)
        {
            <figure class="media-item">
                @if (file.IsVideo)
                {
                    <video src="@file.Url" muted loop playsinline controls preload="metadata"></video>
                }
                else
                {
                    <img src="@file.Url" alt="" loading="lazy" />
                }
                <figcaption>
                    <span class="media-name">@file.FileName</span>
                    <span class="hint">@file.SizeLabel · @(file.IsVideo ? "video" : "image")</span>
                    <form method="post" asp-page-handler="Delete"
                          onsubmit="return confirm('Delete this media?');">
                        <input type="hidden" name="fileName" value="@file.FileName" />
                        <button type="submit" class="link-button danger">Delete</button>
                    </form>
                </figcaption>
            </figure>
        }
    </div>
}

<h2 class="section-title">Content folder</h2>
<p class="hint">
    Files downloaded with yt-dlp from the blog editor land in <code>content/</code>.
    Copy them here and they enter the 404 rotation; files already present are skipped.
</p>

@if (Model.ContentFiles.Count == 0)
{
    <div class="empty">
        <p>The content folder is empty.</p>
        <p>Open a post, put a video link in the body and use <strong>Download media</strong>.</p>
    </div>
}
else
{
    <form method="post" asp-page-handler="CopyFromContent" class="upload-form"
          onsubmit="return confirm('Copy every file from content into 404?');">
        <p class="hint">
            @(Model.ContentFiles.Count == 1 ? "1 file" : $"{Model.ContentFiles.Count} files"),
            @Model.ContentSizeLabel in <code>content/</code>.
        </p>
        <button type="submit" class="button">Copy to 404</button>
    </form>

    <div class="table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>File</th>
                    <th>Size</th>
                    <th>Downloaded</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var file in Model.ContentFiles)
                {
                    <tr>
                        <td><span class="table-slug">@file.FileName</span></td>
                        <td class="cell-date">@file.SizeLabel</td>
                        <td class="cell-date">@file.Modified.ToString("d MMM yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script src="~/js/upload.js" asp-append-version="true"></script>
}
