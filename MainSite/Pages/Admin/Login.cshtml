@page "/admin/login"
@model MainSite.Pages.Admin.LoginModel
@{
    ViewData["Title"] = "Accedi";
}

<div class="auth-card">
    <p class="eyebrow">Area di scrittura</p>
    <h1>Accedi</h1>

    @if (Model.Error is not null)
    {
        <div class="alert error">@Model.Error</div>
    }

    @if (Model.Fake)
    {
        <div class="alert warning">
            <strong>Modalità sviluppo.</strong>
            L'accesso è finto e non passa da mailcow: in produzione questa scorciatoia non esiste.
        </div>
        <p>Entrerai come <strong>@Model.FakeAuthor</strong>.</p>
        <form method="post">
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <button type="submit" class="button button-block">Entra come autore</button>
        </form>
    }
    else if (Model.Enabled)
    {
        <p>
            L'accesso usa la tua casella <strong>@Model.MailcowHost</strong>: verrai portato
            sulla webmail, mailcow ti autentica (password e 2FA compresi) e poi torni qui.
            La password non passa dal blog.
        </p>
        <form method="post">
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <button type="submit" class="button button-block">Accedi con mailcow</button>
        </form>
    }
    else
    {
        <div class="alert warning">
            L'accesso non è ancora configurato: mancano il client OAuth2 di mailcow
            e l'elenco delle caselle abilitate.
        </div>
        <p class="muted">
            Lato mailcow serve un'app OAuth2 con redirect
            <code>/admin/login/callback</code>; poi il client ID, il secret e le caselle
            abilitate vanno nelle variabili <code>MAILCOW_OAUTH_*</code> e
            <code>BLOG_AUTHORS</code>.
        </p>
    }

    <p class="auth-back"><a asp-page="/Blog/Index">← Torna al blog</a></p>
</div>
