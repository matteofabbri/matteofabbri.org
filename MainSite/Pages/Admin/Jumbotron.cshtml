@page "/admin/jumbotron"
@model MainSite.Pages.Admin.JumbotronModel
@{
    ViewData["Title"] = "Jumbotron media";
}

<div class="page-head">
    <div>
        <p class="eyebrow"><a asp-page="/Admin/Index">Administration</a> / Jumbotron</p>
        <h1>Jumbotron media</h1>
        <p class="lede">Photos and videos shown at random in the blog jumbotron.</p>
    </div>
</div>

@if (TempData["Messaggio"] is string message)
{
    <div class="alert success">@message</div>
}
@if (TempData["Errore"] is string error)
{
    <div class="alert error">@error</div>
}

<form method="post" enctype="multipart/form-data" class="upload-form"
      data-upload-form data-max-bytes="@MediaUploadBatch.MaxRequestBytes">
    <label class="field">
        <span class="field-label">Upload photos or videos</span>
        <input type="file" name="Upload" multiple
               accept="image/jpeg,image/png,image/gif,image/webp,image/avif,video/mp4,video/webm,video/quicktime,video/x-m4v" />
        <span class="hint">Drag files here or click to choose. Images up to 15 MB (JPG, PNG, GIF, WebP, AVIF); videos up to 25 MB (MP4, WebM, MOV, M4V).</span>
    </label>
    <button type="submit" class="button">Upload</button>
    <p class="drop-note" aria-hidden="true">Drop to upload</p>
    <p class="upload-status" data-upload-status role="status" hidden></p>
</form>

@if (Model.Files.Count == 0)
{
    <div class="empty">
        <p>No jumbotron media uploaded yet.</p>
        <p>The jumbotron uses the gradient (or the photos committed in <code>wwwroot/photos</code>).</p>
    </div>
}
else
{
    <div class="media-grid">
        @foreach (var file in Model.Files)
        {
            <figure class="media-item">
                @if (file.IsVideo)
                {
                    <video src="@file.Url" muted loop playsinline controls preload="metadata"></video>
                }
                else
                {
                    <img src="@file.Url" alt="" loading="lazy" />
                }
                <figcaption>
                    <span class="media-name">@file.FileName</span>
                    <span class="hint">@file.SizeLabel · @(file.IsVideo ? "video" : "image")</span>
                    <form method="post" asp-page-handler="Delete"
                          onsubmit="return confirm('Delete this media?');">
                        <input type="hidden" name="fileName" value="@file.FileName" />
                        <button type="submit" class="link-button danger">Delete</button>
                    </form>
                </figcaption>
            </figure>
        }
    </div>
}

@section Scripts {
    <script src="~/js/upload.js" asp-append-version="true"></script>
}
