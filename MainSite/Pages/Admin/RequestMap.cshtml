@page "/admin/richieste"
@model MainSite.Pages.Admin.RequestMapModel
@{
    ViewData["Title"] = "Richieste per regione";
}

@section Head {
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/request-map.css" asp-append-version="true" />
}

<div class="page-head">
    <div>
        <p class="eyebrow"><a asp-page="/Admin/Index">I tuoi articoli</a> / Richieste</p>
        <h1>Richieste per regione</h1>
        <p class="lede">Da dove arrivano le richieste del sito: @Model.PeriodLabel.</p>
    </div>
    <form method="get" class="map-controls">
        <label class="field map-period">
            <span class="field-label">Periodo</span>
            <select name="days" onchange="this.form.submit()">
                <option value="7" selected="@(Model.Days == 7)">Ultimi 7 giorni</option>
                <option value="30" selected="@(Model.Days == 30)">Ultimi 30 giorni</option>
                <option value="90" selected="@(Model.Days == 90)">Ultimi 90 giorni</option>
            </select>
        </label>
        <noscript><button type="submit" class="button">Aggiorna</button></noscript>
    </form>
</div>

@if (Model.LoadFailed)
{
    <div class="alert error">
        <strong>Impossibile leggere i conteggi da Sperone.</strong>
        Controlla i log del sito: il database potrebbe non essere accessibile.
    </div>
}
else if (!Model.LogEnabled)
{
    <div class="alert error">
        <strong>Log delle richieste disattivato.</strong>
        Attiva <code>RequestLog:Enabled</code> per raccogliere i dati che alimentano questa pagina.
    </div>
}
else if (!Model.GeoIpAvailable)
{
    <div class="alert warning">
        <strong>Database GeoIP non configurato.</strong>
        La mappa resterà vuota finché non scarichi DB-IP Lite City in
        <code>@Model.GeoIpPath</code>. In locale esegui <code>.\deploy\update-geoip.ps1</code>;
        in produzione <code>sudo /opt/matteofabbri/update-geoip.sh /opt/matteofabbri/geoip</code>
        e riavvia il sito.
    </div>
}
else if (Model.GeoIpUpdated is { } updated)
{
    <p class="hint">GeoIP: DB-IP Lite City, aggiornato al @updated.ToLocalTime().ToString("d MMMM yyyy").</p>
}

<div class="map-summary">
    <div class="map-stat">
        <span class="map-number">@Model.FormatNumber(Model.TotalRequests)</span>
        <span class="map-label">richieste nel periodo</span>
    </div>
    <div class="map-stat">
        <span class="map-number">@Model.FormatNumber(Model.GeocodedRequests)</span>
        <span class="map-label">con una regione italiana</span>
    </div>
    <div class="map-stat">
        <span class="map-number">@Model.FormatNumber(Model.UnknownRequests)</span>
        <span class="map-label">estere, private o non geolocalizzate</span>
    </div>
</div>

@if (Model.TotalRequests == 0)
{
    <div class="empty">
        <p>Nessuna richiesta registrata nel periodo.</p>
        <p>Le nuove richieste compaiono qui entro pochi secondi.</p>
    </div>
}

<div class="map-card">
    <div class="map-header">
        <h2>Mappa delle regioni</h2>
        <div id="map-legend" class="map-legend" hidden>
            <span class="legend-title">Richieste</span>
            <div id="legend-scale" class="legend-scale"></div>
        </div>
    </div>
    <div id="request-map" class="request-map" role="application"
         aria-label="Mappa dell'Italia con le regioni colorate per numero di richieste"></div>
    <p id="map-loading" class="hint">Caricamento della mappa…</p>
    <p id="map-error" class="alert error" hidden>
        Impossibile caricare i confini delle regioni. Ricarica la pagina o controlla la console.
    </p>
</div>

<div class="table-wrap">
    <table class="admin-table region-table">
        <thead>
            <tr>
                <th>Regione</th>
                <th class="cell-number">Richieste</th>
                <th class="cell-number">% sul totale</th>
                <th class="region-bar-cell"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var region in Model.Regions)
            {
                <tr>
                    <td>@region.Name</td>
                    <td class="cell-number">@Model.FormatNumber(region.Count)</td>
                    <td class="cell-number">@Model.PercentLabel(region.Count) %</td>
                    <td class="region-bar-cell">
                        <span class="region-bar" style="width:@(Model.BarWidth(region.Count))%"></span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<p class="hint map-attribution">
    Geolocalizzazione IP: <a href="https://db-ip.com" target="_blank" rel="noopener">DB-IP</a> (CC BY 4.0).
    Confini regioni: <a href="https://github.com/openpolis/geojson-italy" target="_blank" rel="noopener">openpolis/geojson-italy</a> (ISTAT, CC BY 4.0).
    Mappa: &copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors,
    <a href="https://leafletjs.com" target="_blank" rel="noopener">Leaflet</a>.
</p>

<script id="region-counts" type="application/json">@Html.Raw(Model.CountsJson)</script>

@section Scripts {
    <script src="~/lib/leaflet/leaflet.js" asp-append-version="true"></script>
    <script>
        (() => {
            const counts = JSON.parse(document.getElementById('region-counts').textContent);
            const total = @Model.TotalRequests.ToString(System.Globalization.CultureInfo.InvariantCulture);
            const map = L.map('request-map', { preferCanvas: true, scrollWheelZoom: true })
                .setView([42.5, 12.5], 6);

            L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 10,
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
            }).addTo(map);

            const palette = ['#e9e7e1', '#d7efe9', '#a9dcd2', '#7cc9c0', '#4aa99f', '#206f68'];
            const values = Object.values(counts).filter(value => value > 0);
            const max = values.length ? Math.max(...values) : 0;
            const bucket = value => value <= 0
                ? 0
                : Math.min(5, 1 + Math.floor((value - 1) / Math.max(1, max) * 5));
            const color = value => palette[bucket(value)];
            const formatNumber = value => value.toLocaleString('it-IT');

            const geo = L.geoJSON(null, {
                style: feature => ({
                    fillColor: color(counts[feature.properties.reg_istat_code_num] || 0),
                    weight: 1,
                    color: '#ffffff',
                    fillOpacity: 0.88
                }),
                onEachFeature: (feature, layer) => {
                    const count = counts[feature.properties.reg_istat_code_num] || 0;
                    const percent = total ? (count * 100 / total).toFixed(1).replace('.', ',') : '0,0';
                    layer.bindTooltip(`${feature.properties.reg_name}: ${formatNumber(count)}`, { sticky: true });
                    layer.bindPopup(`<strong>${feature.properties.reg_name}</strong><br>${formatNumber(count)} richieste (${percent}% del totale)`);
                    layer.on('mouseover', () => layer.setStyle({ weight: 2, color: '#1c1b19' }));
                    layer.on('mouseout', () => geo.resetStyle(layer));
                }
            }).addTo(map);

            fetch('@Url.Content("~/maps/italy-regions.geojson")')
                .then(response => {
                    if (!response.ok) throw new Error(`HTTP ${response.status}`);
                    return response.json();
                })
                .then(data => {
                    geo.addData(data);
                    // Il GeoJSON ha il bbox dell'Italia: più affidabile del
                    // bounds calcolato sul layer per inquadrare tutta la mappa.
                    if (Array.isArray(data.bbox) && data.bbox.length === 4) {
                        map.fitBounds(
                            [[data.bbox[1], data.bbox[0]], [data.bbox[3], data.bbox[2]]],
                            { padding: [16, 16] });
                    } else {
                        map.fitBounds(geo.getBounds(), { padding: [16, 16] });
                    }
                    document.getElementById('map-loading').hidden = true;
                    buildLegend(max);
                })
                .catch(error => {
                    console.error('Confini regioni:', error);
                    document.getElementById('map-loading').hidden = true;
                    document.getElementById('map-error').hidden = false;
                });

            function buildLegend(maxValue) {
                if (!maxValue) return;
                const scale = document.getElementById('legend-scale');
                const zero = document.createElement('span');
                zero.className = 'legend-item';
                zero.innerHTML = `<span class="legend-swatch" style="background:${palette[0]}"></span>0`;
                scale.appendChild(zero);
                for (let i = 1; i <= 5; i++) {
                    // Stessi intervalli della funzione bucket() usata per i colori.
                    const from = Math.ceil((i - 1) * maxValue / 5) + 1;
                    const to = Math.ceil(i * maxValue / 5);
                    if (from > maxValue) break;
                    const item = document.createElement('span');
                    item.className = 'legend-item';
                    item.innerHTML = `<span class="legend-swatch" style="background:${palette[i]}"></span>${formatNumber(from)}${to > from ? '–' + formatNumber(to) : ''}`;
                    scale.appendChild(item);
                }
                document.getElementById('map-legend').hidden = false;
            }
        })();
    </script>
}
