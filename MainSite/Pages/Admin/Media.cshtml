@page "/admin/media"
@model MainSite.Pages.Admin.MediaModel
@{
    ViewData["Title"] = "Images";
}

<div class="page-head">
    <div>
        <p class="eyebrow"><a asp-page="/Admin/Index">Your posts</a> / Images</p>
        <h1>Images</h1>
        <p class="lede">Images uploaded here go into the blog volume and can be referenced from posts.</p>
    </div>
</div>

@if (TempData["Messaggio"] is string message)
{
    <div class="alert success">@message</div>
}
@if (TempData["Errore"] is string error)
{
    <div class="alert error">@error</div>
}

<form method="post" enctype="multipart/form-data" class="upload-form">
    <label class="field">
        <span class="field-label">Upload an image</span>
        <input type="file" name="Upload" accept="image/jpeg,image/png,image/gif,image/webp,image/avif" />
        <span class="hint">JPG, PNG, GIF, WebP or AVIF. Max 8 MB.</span>
    </label>
    <button type="submit" class="button">Upload</button>
</form>

@if (Model.Files.Count == 0)
{
    <div class="empty"><p>No images uploaded yet.</p></div>
}
else
{
    <div class="media-grid">
        @foreach (var file in Model.Files)
        {
            <figure class="media-item">
                <img src="@file.Url" alt="" loading="lazy" />
                <figcaption>
                    <span class="media-name">@file.FileName</span>
                    <span class="hint">@file.SizeLabel</span>
                    <code>![description](@file.Url)</code>
                </figcaption>
            </figure>
        }
    </div>
}
