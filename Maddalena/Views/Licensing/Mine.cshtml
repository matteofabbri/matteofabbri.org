@model IReadOnlyList<Maddalena.Data.AccountLicense>
@{
    ViewData["Title"] = "My licenses";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sperone — my licenses</title>
    <style>
        body { font-family: system-ui, sans-serif; max-width: 52rem; margin: 2rem auto; padding: 0 1rem; }
        table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
        th, td { text-align: left; padding: 0.4rem 0.6rem; border-bottom: 1px solid #ddd; }
        th { background: #f5f5f5; }
        a { color: #06c; }
        .muted { color: #777; }
        .expired { color: #b00; }
    </style>
</head>
<body>
    <h1>My licenses</h1>
    <form method="post" action="/licensing/buy" style="margin-bottom:1.5rem;">
        <button type="submit" style="padding:0.5rem 1rem; font:inherit; cursor:pointer;">Buy another (1 year) — €99</button>
    </form>

    @if (Model.Count == 0)
    {
        <p class="muted">You have no licenses yet.</p>
    }
    else
    {
        <table>
            <thead>
                <tr><th>Issued (UTC)</th><th>Kind</th><th>Max nodes</th><th>Expires</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var lic in Model)
                {
                    var expired = lic.ExpiresAt < DateTime.UtcNow;
                    <tr>
                        <td>@lic.IssuedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@lic.Kind</td>
                        <td>@lic.MaxNodes</td>
                        <td class="@(expired ? "expired" : "")">@lic.ExpiresAt.ToString("yyyy-MM-dd")@(expired ? " (expired)" : "")</td>
                        <td><a href="/licensing/download/@lic.Id">download</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</body>
</html>
