@model Maddalena.Controllers.RegisterModel
@{
    ViewData["Title"] = "Create account";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Maddalena — create account</title>
    <style>
        body { font-family: system-ui, sans-serif; max-width: 24rem; margin: 4rem auto; padding: 0 1rem; line-height: 1.5; }
        h1 { font-size: 1.4rem; }
        label { display: block; margin-top: 1rem; font-size: 0.9rem; }
        input { width: 100%; box-sizing: border-box; padding: 0.5rem 0.6rem; font: inherit; border: 1px solid #bbb; border-radius: 0.35rem; margin-top: 0.25rem; }
        button { margin-top: 1.5rem; width: 100%; padding: 0.6rem 1.2rem; font: inherit; cursor: pointer; }
        .errors ul { color: #b00; margin: 1rem 0 0; padding-left: 1.2rem; }
        .muted { color: #666; font-size: 0.9rem; }
        a { color: #06c; }
    </style>
</head>
<body>
    <h1>Create account</h1>
    <p class="muted">One account for maddalena.me and its sites.</p>
    <form method="post" asp-action="Register">
        <input type="hidden" asp-for="ReturnUrl" />
        <div class="errors" asp-validation-summary="All"></div>
        <label>Email <input asp-for="Email" type="email" autocomplete="username" autofocus /></label>
        <label>Password (8+ characters) <input asp-for="Password" autocomplete="new-password" /></label>
        <label>Confirm password <input asp-for="ConfirmPassword" autocomplete="new-password" /></label>
        <button type="submit">Create account</button>
    </form>
    <p class="muted">Already registered? <a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Sign in</a>.</p>
</body>
</html>
