# Caddyfile — the front door (site names + analytics, TLS terminated here).
#
# LOGIC: Caddy knows only a short, stable list of names and terminates their TLS
# with Let's Encrypt certificates. There is no mail stack on this machine any
# more: a name that is not one of these is simply not routed.
#
# The SITES are THREE (each with its block at the bottom + its name in the
# @site matcher below). Umami analytics is not a separate host: it is served
# under /analytics on the personal site, from a custom image built with
# BASE_PATH=/analytics.
#   - matteofabbri.org  (SITE_DOMAIN)      -> personal site (+ /analytics)
#   - theqult.org       (THEQULT_DOMAIN)   -> TheQult site (community)
#   - maddalena.me      (MADDALENA_DOMAIN) -> Maddalena MVC site
#
# Variables (set by the Aspire AppHost / the compose .env):
#   SITE_DOMAIN           -> personal site domain   (e.g. matteofabbri.org)
#   THEQULT_DOMAIN        -> second site            (e.g. theqult.org)
#   MADDALENA_DOMAIN      -> third site             (e.g. maddalena.me)
#   SITE_UPSTREAM         -> personal site backend  (e.g. site:8080)
#   THEQULT_UPSTREAM      -> TheQult backend        (e.g. theqult:8080)
#   MADDALENA_UPSTREAM    -> Maddalena backend      (e.g. maddalena:8080)
#   UMAMI_UPSTREAM        -> Umami backend          (e.g. umami:3000)
{
	# INTERNAL ports of Caddy's HTTP/HTTPS server. The real public ports
	# (80/443) are held by the layer4 server below.
	http_port 8080
	https_port 8443

	# The layer4 server forwards site traffic to this HTTP server: without the
	# PROXY protocol the client IP would collapse to 127.0.0.1 (GeoIP, per-IP
	# rate limits and logs would all see the same client). The wrapper must come
	# before tls, which would otherwise read the header as the start of the
	# handshake. fallback_policy use: use the address in the header when it is
	# there; connections without a header (e.g. the internal port 8080) still
	# pass.
	servers {
		listener_wrappers {
			proxy_protocol {
				fallback_policy use
			}
			tls
		}
	}

	# ACME account for Let's Encrypt (only for the sites Caddy terminates).
	email {$ACME_EMAIL}

	# --- TCP-level routing, before TLS --------------------------------------
	layer4 {
		# Public HTTPS (443)
		:443 {
			# Sites: recognise the name in the handshake (SNI) and terminate
			# TLS here. For a new site: add its domain (and its www.) to this
			# line and create its block at the bottom of the file.
			@site tls sni {$SITE_DOMAIN} www.{$SITE_DOMAIN} {$THEQULT_DOMAIN} www.{$THEQULT_DOMAIN} {$MADDALENA_DOMAIN} www.{$MADDALENA_DOMAIN}
			route @site {
				proxy {
					upstream 127.0.0.1:8443
					# Pass the original IP to the internal HTTP server (same
					# process, different connection).
					proxy_protocol v1
				}
			}
		}

		# Public HTTP (80)
		:80 {
			# Sites: to Caddy's internal HTTP server (it redirects to https).
			@site http host {$SITE_DOMAIN} www.{$SITE_DOMAIN} {$THEQULT_DOMAIN} www.{$THEQULT_DOMAIN} {$MADDALENA_DOMAIN} www.{$MADDALENA_DOMAIN}
			route @site {
				proxy {
					upstream 127.0.0.1:8080
				}
			}
		}
	}
}

# --- Headers shared by every site (imported with "import secure_headers") ----
# A little more security, a little less information:
#   - HSTS: the browser remembers "this site over https only" for a year.
#     No includeSubDomains: subdomains are someone else's house, we do not
#     bind them.
#   - X-Frame-Options: the page cannot be framed by third-party sites
#     (clickjacking).
#   - Referrer-Policy: external links receive only the domain, not the full URL.
#   - -Server/-Via: we do not reveal that Kestrel and Caddy sit behind the reply
#     (Caddy applies removals at the end of the response, so they also cover
#     headers added by reverse_proxy and by the upstream).
(secure_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
		-Via
	}
}

# --- Personal site (TLS terminated by Caddy) ---------------------------------
# www. is included only for its certificate + redirect to the bare domain (e.g.
# if the registrar creates a www. next to the main record).
{$SITE_DOMAIN}, www.{$SITE_DOMAIN} {
	import secure_headers

	@www host www.{$SITE_DOMAIN}
	redir @www https://{$SITE_DOMAIN}{uri} permanent

	# Umami analytics under the main domain. The custom Umami image is built
	# with BASE_PATH=/analytics, so the prefix is forwarded as-is (no strip).
	# Umami itself redirects /analytics/ to /analytics: do not add a redirect
	# here or the two bounce forever.
	@analytics path /analytics /analytics/*
	handle @analytics {
		reverse_proxy {$UMAMI_UPSTREAM}
	}

	# Everything else -> the personal site.
	handle {
		reverse_proxy {$SITE_UPSTREAM}
	}
}

# --- theqult.org (hospitality community) -------------------------------------
{$THEQULT_DOMAIN}, www.{$THEQULT_DOMAIN} {
	import secure_headers

	@www host www.{$THEQULT_DOMAIN}
	redir @www https://{$THEQULT_DOMAIN}{uri} permanent

	# Everything else -> the TheQult site.
	handle {
		reverse_proxy {$THEQULT_UPSTREAM}
	}
}

# --- maddalena.me (MVC site) -------------------------------------------------
{$MADDALENA_DOMAIN}, www.{$MADDALENA_DOMAIN} {
	import secure_headers

	@www host www.{$MADDALENA_DOMAIN}
	redir @www https://{$MADDALENA_DOMAIN}{uri} permanent

	# Everything else -> the Maddalena site.
	handle {
		reverse_proxy {$MADDALENA_UPSTREAM}
	}
}

# --- Future sites: copy a block above (domain + www.) and add both names to
# --- the @site matcher in the :443 and :80 sections.
