<Project Sdk="Aspire.AppHost.Sdk/13.4.3">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>b005af73-51e5-44b6-b3ab-50757badff04</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Docker" Version="13.4.3" />
    <!-- Fa nascere il container Mongo per il sito licenze (prima stava nell'AppHost
         dedicato dentro SPERONE, ora lo ospitiamo qui). -->
    <PackageReference Include="Aspire.Hosting.MongoDB" Version="13.4.3" />
    <PackageReference Include="MessagePack" Version="3.1.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MainSite\MainSite.csproj" />
    <!-- Progetto da un ALTRO repo (SPERONE), portato qui come sottomodulo git in
         external/SPERONE. Il percorso relativo risolve sia in locale sia dopo un
         clone ricorsivo, perche' il sottomodulo mette i file in quella cartella. -->
    <ProjectReference Include="..\external\SPERONE\LICENSING\Sperone.LicenseSite\Sperone.LicenseSite.csproj" />
  </ItemGroup>

</Project>
